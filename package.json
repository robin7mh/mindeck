{
  "name": "mindeck",
  "version": "0.1.0",
  "description": "Mindeck — a dark, futuristic Sci-Fi command-center desktop app.",
  "author": "Robin Hinkelmann",
  "desktopName": "mindeck.desktop",
  "license": "SEE LICENSE IN LICENSE",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node --max-old-space-size=4096 node_modules/electron-vite/bin/electron-vite.js build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "lint": "eslint src",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js build --config vite.web.config.ts",
    "server:build": "vite build --config vite.server.config.ts",
    "server": "node out/server/index.cjs",
    "server:pair": "node out/server/index.cjs pair",
    "remote:bundle": "node scripts/remote-bundle.mjs",
    "web": "npm run web:build && npm run server:build && npm run server",
    "postinstall": "node scripts/fix-node-pty.cjs",
    "docker:build": "docker build -t ghcr.io/robin7mh/mindeck:local .",
    "docker:up": "docker compose up -d --build --wait",
    "docker:pair": "docker exec mindeck-core node out/server/index.cjs pair",
    "docker:logs": "docker compose logs -f core",
    "docker:down": "docker compose down",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && npm run web:build && npm run server:build && playwright test",
    "test:all": "npm run typecheck && npm run test:coverage && npm run test:e2e",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:mac:dir": "npm run build && electron-builder --mac --dir --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "release:mac": "npm run build && electron-builder --mac --publish always"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@anthropic-ai/sdk": "^0.131.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@devcontainers/cli": "^0.89.0",
    "@fontsource-variable/inter": "^5.0.20",
    "@fontsource/jetbrains-mono": "^5.0.20",
    "@ghostery/adblocker": "^2.20.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.3.19",
    "ignore": "^5.3.2",
    "lucide-react": "^0.427.0",
    "marked": "^18.0.14",
    "monaco-editor": "^0.57.0",
    "monaco-vim": "^0.4.4",
    "mongodb": "^7.7.0",
    "node-pty": "^1.1.0",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.105.1",
    "selfsigned": "^5.5.0",
    "ssh2-sftp-client": "^12.1.1",
    "systeminformation": "^5.33.15",
    "typescript": "^5.5.4",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.19",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "homepage": "https://github.com/robin7mh/mindeck"
}
