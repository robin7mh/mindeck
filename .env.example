# Copy to .env to change the defaults. Everything works without it.
# docker-compose.yml reads these; the app reads the MINDECK_* ones directly.

# Mindeck core in Docker (npm run docker:up)
MINDECK_CORE_PORT=7420
# 0.0.0.0 = reachable from other devices on your network (phone). Pairing protects it.
MINDECK_BIND=127.0.0.1
# Folder on the host whose sub-folders the core may add as projects (/projects inside).
# Default: ./projects next to docker-compose.yml (an empty folder — never this one, it holds .env).
# MINDECK_PROJECTS_DIR=~/Projects
# ro (default): read only. rw: the core may save, rename and delete files in it — needed for
# editing from the web UI / app and for remote shells that change files.
# MINDECK_PROJECTS_MODE=rw
# HTTPS for everyone but the core's own machine (1, the default): a self-signed certificate
# in the mindeck-data volume, checked by the fingerprint in the pairing QR code. 0 = plain HTTP
# (e.g. behind a reverse proxy that does TLS). An own certificate (PEM files mounted into the
# container): MINDECK_TLS_CERT=/certs/fullchain.pem and MINDECK_TLS_KEY=/certs/privkey.pem.
MINDECK_TLS=1
# The core answers to its IP addresses, localhost, its machine name (+ .local) and its
# certificate's names only (against DNS rebinding). Other names it is reached by — a reverse
# proxy's domain, the Docker host's name, tailscale serve — comma-separated; .example.com =
# every subdomain, * = any name.
# MINDECK_ALLOWED_HOSTS=mindeck.example.com,nas.local
# Let paired devices open real shells (0/1). Off by default.
MINDECK_REMOTE_TERMINAL=0
# LLM key for the assistant (can also be set in Settings → AI).
# ANTHROPIC_API_KEY=

# Standalone core without Docker (npm run web / npm run server)
# MINDECK_PORT=7420
# MINDECK_LAN=1          (with it, HTTPS for the network; MINDECK_TLS=0 to switch that off)

# Everything Mindeck stores (vault, settings, projects, devices) lives here:
# MINDECK_HOME=~/Mindeck

# Mindeck account & license (Mindeck Cloud). Dev runs need no license; to try the gate:
# MINDECK_LICENSE=required
# MINDECK_CLOUD_URL=http://localhost:8080
# Release builds bake both in: MINDECK_CLOUD_URL=… MINDECK_CLOUD_KEY=… npm run build
