<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Electron's helper apps (renderer, GPU, the utility processes without project code): V8's JIT and nothing
     else — like @electron/osx-sign's defaults for renderer and GPU. Pages (and a compromised renderer) can't
     load foreign libraries. The plugin helper gets entitlements.mac.plugin.plist (build/sign.cjs). -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
